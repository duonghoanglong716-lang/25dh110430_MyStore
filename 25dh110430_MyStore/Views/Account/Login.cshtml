@model _25dh110430_MyStore.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    /* Nền trang đăng nhập */
    body {
        background-color: #ee4d2d !important;
        min-height: 100vh;
        margin: 0;
        font-family: Arial, sans-serif;
    }

    /* Khung đăng nhập */
    .form-horizontal {
        width: 500px;
        max-width: calc(100% - 30px);
        margin: 20px auto;
        background: #fff;
        padding: 45px 37px 35px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        box-sizing: border-box;
        text-align: left;
    }

        /* Tiêu đề */
        .form-horizontal h2 {
            font-size: 25px;
            font-weight: 400;
            color: #222;
            margin: 0 0 35px;
            text-align: left;
        }

        /* Các hàng nhập liệu */
        .form-horizontal .form-group {
            display: block;
            margin: 0 0 30px !important;
            width: 100%;
        }

        /* Nhãn */
        .form-horizontal .control-label {
            display: block;
            width: 100%;
            text-align: left !important;
            padding: 0;
            margin-bottom: 8px;
            font-weight: 500;
        }

        /* Cột Bootstrap */
        .form-horizontal .col-md-4,
        .form-horizontal .col-md-6,
        .form-horizontal .col-md-8,
        .form-horizontal .col-md-offset-2 {
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* Ô nhập Email và mật khẩu */
        .form-horizontal .form-control {
            width: 100% !important;
            height: 50px;
            padding: 10px 15px;
            border: 1px solid #ccc;
            border-radius: 2px;
            box-shadow: none;
            font-size: 16px;
            box-sizing: border-box;
        }

            .form-horizontal .form-control:focus {
                border-color: #ee4d2d;
                outline: none;
                box-shadow: 0 0 4px rgba(238,77,45,0.2);
            }

    /* Nút đăng nhập */
    .accountbtn {
        width: 100% !important;
        max-width: none !important;
        height: 50px !important;
        background-color: #ee4d2d !important;
        border: 1px solid #ee4d2d !important;
        color: white !important;
        font-size: 16px;
        font-weight: bold;
        border-radius: 3px;
        text-transform: uppercase;
        margin: 5px 0 15px;
        cursor: pointer;
    }

        .accountbtn:hover {
            background-color: #d73211 !important;
            border-color: #d73211 !important;
        }

    /* Checkbox duy trì đăng nhập */
    .form-horizontal input[type="checkbox"] {
        accent-color: #ee4d2d;
        width: 20px;
        height: 20px;
        vertical-align: middle;
    }

    /* Link */
    .form-horizontal a {
        color: #0055aa;
        text-decoration: none;
    }

        .form-horizontal a:hover {
            text-decoration: underline;
        }

    /* Các đoạn văn bản */
    .form-horizontal p {
        text-align: center;
        font-size: 14px;
        line-height: 1.6;
        margin-top: 20px;
    }

    /* Chia cách OR */
    .form-horizontal hr {
        border: none;
        border-top: 1px solid #ddd;
        margin: 25px 0;
    }

    /* Nút mạng xã hội */
    .social-login {
        display: flex;
        gap: 12px;
        width: 100%;
    }

        .social-login button {
            flex: 1;
            height: 50px;
            background: white;
            border: 1px solid #ccc;
            border-radius: 3px;
            font-size: 16px;
            cursor: pointer;
        }
</style>

<div>
    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                <h2 class="col-md-6" style="text-align: center;">Đăng nhập</h2>
            </div>

            @* Tên đăng nhập *@
            <div class="form-group">
                @Html.LabelFor(m => m.Username, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Mật khẩu *@
            <div class="form-group">
                @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Nút Submit & Link đăng ký *@
            <div class="form-group">
                <div class="col-md-offset-2 col-md-4">
                    <input type="submit" value="Đăng nhập" class="btn btn-info accountbtn" /><br />
                    <p>Bạn Chưa Có Tài Khoản? <a href="@Url.Action("Register", "Account", null)">Đăng ký ngay</a></p>
                </div>
            </div>
        </div>
    }
</div>