@model _25dh110430_MyStore.Models.ViewModel.RegisterVM

@{
    ViewBag.Title = "ĐĂNG KÝ TÀI KHOẢN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    /* TRANG ĐĂNG NHẬP / ĐĂNG KÝ */
    div > form,
    .form-horizontal {
        width: 100%;
        max-width: 650px;
        margin: 40px auto;
        padding: 30px;
        background: #fff;
        border: 1px solid #00a6c7;
        border-radius: 5px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        text-align: left;
        box-sizing: border-box;
    }

        /* TIÊU ĐỀ */
        .form-horizontal h2,
        .form-group h2 {
            width: 100%;
            text-align: left;
            font-size: 28px;
            font-weight: 700;
            color: #222;
            margin: 0 0 25px;
        }

        /* CÁC HÀNG FORM */
        .form-horizontal .form-group {
            display: block;
            width: 100%;
            margin: 0 0 23px !important;
            padding: 0;
        }

        /* NHÃN */
        .form-horizontal .control-label {
            display: block;
            width: 100%;
            text-align: left !important;
            padding: 0;
            margin-bottom: 9px;
            font-size: 14px;
            font-weight: 700;
            color: #222;
        }

        /* CÁC CỘT BOOTSTRAP */
        .form-horizontal .col-md-4,
        .form-horizontal .col-md-6,
        .form-horizontal .col-md-8,
        .form-horizontal .col-md-offset-2 {
            width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            margin-left: 0 !important;
        }

        /* Ô NHẬP LIỆU */
        .form-horizontal .form-control {
            display: block;
            width: 100% !important;
            height: 46px;
            padding: 10px 15px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: #fafafa;
            color: #333;
            font-size: 14px;
            text-align: left;
            box-shadow: none;
            box-sizing: border-box;
        }

            .form-horizontal .form-control:focus {
                border-color: #00a6c7;
                outline: none;
                box-shadow: 0 0 4px rgba(0,166,199,0.15);
            }

    /* NÚT ĐĂNG KÝ MÀU CAM */
    .accountbtn {
        display: inline-block;
        width: 100% !important;
        max-width: 200px !important;
        height: 46px !important;
        padding: 10px 20px;
        background-color: #ee4d2d !important;
        border: 1px solid #ee4d2d !important;
        border-radius: 4px;
        color: #fff !important;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        text-align: center;
        margin: 10px 0;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .accountbtn:hover {
            background-color: #00839b !important;
            border-color: #00839 !important;
        }

    /* LINK VÀ ĐOẠN VĂN BẢN */
    .form-horizontal p {
        width: 100%;
        text-align: left;
        margin-top: 10px;
        color: #777;
        font-size: 14px;
    }

    .form-horizontal div > a {
        color: #00a6c7;
        text-decoration: none;
    }

        .form-horizontal div > a:hover {
            text-decoration: underline;
        }

    /* VALIDATION */
    .form-horizontal .field-validation-error {
        display: block;
        color: #dc3545;
        font-size: 13px;
        margin-top: 5px;
    }

    .form-horizontal .validation-summary-errors {
        color: #dc3545;
        margin-bottom: 15px;
    }

    /* RESPONSIVE */
    @@media (max-width: 576px) {
        div > form,
        .form-horizontal {
            width: calc(100% - 20px);
            margin: 25px auto;
            padding: 22px 18px;
        }

            .form-horizontal h2,
            .form-group h2 {
                font-size: 23px;
            }

        .accountbtn {
            max-width: 100% !important;
        }
    }

</style>

<div>
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                <h2 class="col-md-6">Đăng ký tài khoản</h2>
            </div>

            @* Tên đăng nhập *@
            <div class="form-group">
                @Html.LabelFor(model => model.Username, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Username, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Mật khẩu *@
            <div class="form-group">
                @Html.LabelFor(model => model.Password, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Xác nhận mật khẩu *@
            <div class="form-group">
                @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Họ tên khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerName, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
                </div>
            </div>

            @* SĐT khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerPhone, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerPhone, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerPhone, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Email khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerEmail, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerEmail, "", new { @class = "text-danger" })
                </div>
            </div>

            @* Địa chỉ khách hàng *@
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerAddress, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.CustomerAddress, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.CustomerAddress, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-4">
                    <input type="submit" value="Đăng ký" class="btn btn-info accountbtn" /><br />
                    <p>Bạn Đã Có Tài Khoản? <a href="@Url.Action("Login", "Account", null)">Đăng nhập</a></p>
                </div>
            </div>
        </div>
    }
</div>