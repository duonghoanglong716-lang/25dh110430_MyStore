
@model IEnumerable<_25dh110430_MyStore.Models.Product>
@using System.Linq

@{
    ViewBag.Title = ViewBag.CategoryName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .camera-page {
        margin-top: 100px;
        margin-bottom: 50px;
    }

    .camera-header {
        margin-bottom: 25px;
    }

    .camera-result-title {
        font-size: 26px;
        font-weight: bold;
        color: #263f53;
        margin: 0 0 10px;
    }

    .camera-result-count {
        color: #777;
        font-size: 14px;
        margin: 0;
    }

    /* DANH SÁCH SẢN PHẨM */
    .camera-product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
    }

    .camera-product-item {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #eee;
        box-shadow: 0 3px 12px rgba(0,0,0,0.05);
        transition: .25s;
    }

        .camera-product-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }

    .camera-product-image {
        height: 230px;
        background: #f7f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
    }

        .camera-product-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .camera-product-info {
        padding: 16px;
    }

    .camera-product-name {
        color: #263f53;
        font-size: 16px;
        font-weight: bold;
        height: 44px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .camera-product-price {
        color: #e05252;
        font-size: 19px;
        font-weight: bold;
        margin-top: 12px;
        margin-bottom: 12px;
    }

    .product-quantity-info {
        font-size: 13px;
        line-height: 23px;
        color: #777;
        border-top: 1px solid #eee;
        padding-top: 10px;
    }

        .product-quantity-info .stock {
            color: #2580c7;
        }

        .product-quantity-info .sold {
            color: #168653;
        }

    .camera-product-link {
        display: block;
        text-decoration: none;
    }

        .camera-product-link:hover {
            text-decoration: none;
        }

    .camera-empty {
        background: white;
        padding: 50px 20px;
        text-align: center;
        border-radius: 10px;
        color: #777;
    }

        .camera-empty i {
            font-size: 35px;
            color: #aaa;
        }

        .camera-empty h4 {
            margin-top: 15px;
            font-weight: bold;
        }

    /* TABLET */
    @@media (max-width: 992px) {
        .camera-product-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .camera-product-image {
            height: 190px;
        }
    }

    /* MOBILE */
    @@media (max-width: 576px) {
        .camera-page {
            margin-top: 80px;
        }

        .camera-product-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .camera-product-image {
            height: 150px;
        }

        .camera-product-info {
            padding: 10px;
        }

        .camera-product-name {
            font-size: 14px;
            height: 40px;
        }

        .camera-product-price {
            font-size: 16px;
        }
    }
</style>

<div class="container camera-page">

    <!-- TIÊU ĐỀ DANH MỤC -->
    <div class="camera-header">

        <h2 class="camera-result-title">
            @(ViewBag.CategoryName ?? "DANH SÁCH SẢN PHẨM")
        </h2>

        <p class="camera-result-count">
            @if (Model != null)
            {
                <span>Hiển thị @Model.Count() sản phẩm</span>
            }
        </p>

    </div>

    <!-- DANH SÁCH SẢN PHẨM -->
    @if (Model != null && Model.Any())
    {
        <div class="camera-product-grid">

            @foreach (var product in Model)
            {
                <div class="camera-product-item">

                    <a class="camera-product-link"
                       href="@Url.Action("ProductDetails", "Home",
                           new { id = product.ProductID })">

                        <div class="camera-product-image">

                            @if (!string.IsNullOrEmpty(product.ProductImage))
                            {
                                <img src="@product.ProductImage"
                                     alt="@product.ProductName" />
                            }
                            else
                            {
                                <span>Chưa có hình ảnh</span>
                            }

                        </div>

                        <div class="camera-product-info">

                            <div class="camera-product-name">
                                @product.ProductName
                            </div>

                            <div class="camera-product-price">
                                @product.ProductPrice.ToString("N0") VNĐ
                            </div>

                            <div class="product-quantity-info">

                                <span class="stock">
                                    Tồn kho: @product.StockQuantity
                                </span>

                                <br />

                                <span class="sold">
                                    Đã bán: @(product.OrderDetails?.Sum(x => x.Quantity) ?? 0)
                                </span>

                            </div>

                        </div>

                    </a>

                </div>
            }

        </div>
    }
    else
    {
        <div class="camera-empty">

            <i class="glyphicon glyphicon-search"></i>

            <h4>Không tìm thấy sản phẩm</h4>

            <p>Hiện tại chưa có sản phẩm nào trong danh mục này.</p>

        </div>
    }

</div>
